"""
BACKEND — Flask app cho hệ thống dự đoán mức độ trầm cảm
Bước 12.3 - 12.6: Triển khai Backend + Tích hợp DistilBERT + API /predict, /explain

Cách chạy: python app.py
Mặc định chạy tại http://localhost:5000
"""

from flask import Flask, request, jsonify
from flask_cors import CORS
import torch
from transformers import AutoModelForSequenceClassification, AutoTokenizer
import time

app = Flask(__name__)
CORS(app)

# ============================================================
# 1. LOAD MODEL (chỉ 1 lần lúc khởi động server)
# ============================================================
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent
MODEL_PATH = BASE_DIR.parent.parent / "models" / "distilbert_model_tuned"

print("Đang tải model DistilBERT...")
tokenizer = AutoTokenizer.from_pretrained(MODEL_PATH)
model = AutoModelForSequenceClassification.from_pretrained(MODEL_PATH)
model.eval()
print("Đã tải xong model. Server sẵn sàng.")

LABEL_NAMES = ['Minimum', 'Mild', 'Moderate', 'Severe']

WARNING_WORDS = ['suicide', 'suicidal', 'kill', 'die', 'death', 'worthless', 'hopeless',
                  'trống rỗng', 'tự trách', 'tuyệt vọng', 'muốn chết', 'buồn', 'mệt mỏi']

# Mô tả kết quả — khách quan, không khẳng định chẩn đoán
RESULT_DESCRIPTIONS = {
    'Minimum': "Dựa trên nội dung được nhập, mô hình dự đoán bài đăng thuộc mức 'Minimum' theo bộ dữ liệu nghiên cứu.",
    'Mild': "Dựa trên nội dung được nhập, mô hình dự đoán bài đăng thuộc mức 'Mild' theo bộ dữ liệu nghiên cứu.",
    'Moderate': "Dựa trên nội dung được nhập, mô hình dự đoán bài đăng thuộc mức 'Moderate' theo bộ dữ liệu nghiên cứu.",
    'Severe': "Dựa trên nội dung được nhập, mô hình dự đoán bài đăng thuộc mức 'Severe' theo bộ dữ liệu nghiên cứu."
}

# Khuyến nghị — mở rộng thành danh sách gợi ý cụ thể theo từng mức độ
RECOMMENDATIONS = {
    'Minimum': [
        "Duy trì thói quen ngủ đủ giấc và vận động đều đặn.",
        "Dành thời gian kết nối với bạn bè, người thân mỗi tuần.",
        "Ghi lại 1 điều tích cực mỗi ngày, dù nhỏ."
    ],
    'Mild': [
        "Thử viết nhật ký để hiểu rõ hơn cảm xúc của mình.",
        "Chia sẻ với 1 người bạn tin tưởng về những gì đang trải qua.",
        "Dành thời gian nghỉ ngơi, tránh dồn ép bản thân quá mức."
    ],
    'Moderate': [
        "Cân nhắc trò chuyện với chuyên gia tâm lý để được lắng nghe kỹ hơn.",
        "Duy trì kết nối xã hội, tránh thu mình lại một mình.",
        "Nếu cảm xúc này kéo dài trên 2 tuần, đây là dấu hiệu nên tìm hỗ trợ chuyên môn."
    ],
    'Severe': [
        "Hãy liên hệ ngay với người thân hoặc chuyên gia tâm lý hôm nay.",
        "Bạn không cần một mình đối mặt với điều này — luôn có người sẵn sàng lắng nghe.",
        "Nếu có ý nghĩ muốn làm hại bản thân, hãy gọi ngay đường dây nóng bên dưới."
    ]
}

# Nguồn hỗ trợ khủng hoảng — có trường riêng cho phone/email/messenger để Frontend làm nút bấm
CRISIS_RESOURCES = [
    {
        "name": "Tham vấn Tâm lý học đường PU Counseling Services",
        "messenger": "https://m.me/pucounselingservices",
        "email": "pucs@phenikaa-uni.edu.vn"
    },
    {
        "name": "Đường dây nóng Ngày Mai",
        "phone": "0963061414",
        "note": "Hỗ trợ tâm lý miễn phí, chuyên về trầm cảm ở người trẻ"
    }
]


# ============================================================
# 2. INPUT VALIDATION
# ============================================================
def validate_input(text):
    if text is None or text.strip() == '':
        return False, 'Vui lòng nhập nội dung.'
    stripped = text.strip()
    if len(stripped) < 5:
        return False, 'Nội dung quá ngắn, vui lòng chia sẻ chi tiết hơn.'
    if len(stripped) > 3000:
        return False, 'Nội dung quá dài, vui lòng rút gọn dưới 3000 ký tự.'
    unique_chars = len(set(stripped.lower().replace(' ', '')))
    if unique_chars < 4:
        return False, 'Nội dung không hợp lệ.'
    return True, None


def rule_based_highlight(text):
    """CHỈ dựa trên danh sách từ khóa cố định — KHÔNG phản ánh quyết định thực sự của model."""
    text_lower = text.lower()
    return [w for w in WARNING_WORDS if w in text_lower]


# ============================================================
# 3. API /predict — NHANH
# ============================================================
@app.route('/predict', methods=['POST'])
def predict():
    data = request.get_json()
    text = data.get('text', '') if data else ''

    is_valid, error_msg = validate_input(text)
    if not is_valid:
        return jsonify({'error': error_msg}), 400

    t0 = time.time()

    # Model Inference — 4 bước cụ thể
    inputs = tokenizer(text, padding='max_length', truncation=True, max_length=150, return_tensors='pt')
    with torch.no_grad():
        outputs = model(**inputs)
        probabilities = torch.softmax(outputs.logits, dim=1)[0].tolist()
        pred_idx = int(torch.argmax(outputs.logits, dim=1)[0])

    prediction = LABEL_NAMES[pred_idx]
    highlight_words = rule_based_highlight(text)
    response_time = round((time.time() - t0) * 1000, 2)

    result = {
        'prediction': prediction,
        'confidence': round(max(probabilities), 4),
        'probabilities': {LABEL_NAMES[i]: round(p, 4) for i, p in enumerate(probabilities)},
        'result_description': RESULT_DESCRIPTIONS[prediction],
        'recommendations': RECOMMENDATIONS[prediction],
        'highlight_method': 'rule',
        'highlight_words': highlight_words,
        'response_time_ms': response_time
    }

    if prediction == 'Severe':
        result['crisis_resources'] = CRISIS_RESOURCES

    return jsonify(result)


# ============================================================
# 4. API /explain — CHẬM, chỉ chạy khi được yêu cầu
# ============================================================
@app.route('/explain', methods=['POST'])
def explain():
    from lime.lime_text import LimeTextExplainer
    import numpy as np

    data = request.get_json()
    text = data.get('text', '') if data else ''

    is_valid, error_msg = validate_input(text)
    if not is_valid:
        return jsonify({'error': error_msg}), 400

    def predict_proba_batch(texts):
        all_probs = []
        batch_size = 16
        for i in range(0, len(texts), batch_size):
            batch = list(texts[i:i+batch_size])
            enc = tokenizer(batch, padding='max_length', truncation=True, max_length=150, return_tensors='pt')
            with torch.no_grad():
                out = model(**enc)
                p = torch.softmax(out.logits, dim=1).numpy()
            all_probs.append(p)
        return np.vstack(all_probs)

    inputs = tokenizer(text, padding='max_length', truncation=True, max_length=150, return_tensors='pt')
    with torch.no_grad():
        outputs = model(**inputs)
        pred_idx = int(torch.argmax(outputs.logits, dim=1)[0])

    explainer = LimeTextExplainer(class_names=LABEL_NAMES)
    exp = explainer.explain_instance(text, predict_proba_batch,
                                        num_features=10, num_samples=200, labels=[pred_idx])

    explanation = [{'word': w, 'weight': round(wt, 4)} for w, wt in exp.as_list(label=pred_idx)]

    return jsonify({'method': 'LIME', 'explanation': explanation})


# ============================================================
# 5. Chạy server
# ============================================================
if __name__ == '__main__':
    app.run(debug=True, port=5000)